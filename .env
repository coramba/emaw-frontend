# Vite dev server (served from the shared `node` container).
# NODE_HOST is provided by the container (0.0.0.0). NODE_PORT must be a port
# published 1:1 in /home/corwin/docker/docker-compose.yaml — 5171 and 5172 are
# taken by client-app / sp-app, so this project uses 5173.
NODE_PORT=5173

# Backend: host nginx vhost `api-emaw.do.com` -> php-8.2 FPM (existing flow).
# From the node container the docker host / nginx is the aksay_net gateway.
# Adjust if the aksay_net subnet in the shared compose file changes.
VITE_API_TARGET=http://172.30.49.1
VITE_API_HOST_HEADER=api-emaw.do.com
